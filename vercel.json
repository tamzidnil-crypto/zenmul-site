{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/what-we-build", "destination": "/", "permanent": true },
    { "source": "/case-studies", "destination": "/", "permanent": true },
    { "source": "/pricing", "destination": "/contact", "permanent": true },
    { "source": "/solutions", "destination": "/", "permanent": true },
    { "source": "/how-it-works", "destination": "/", "permanent": true },
    { "source": "/integrations", "destination": "/", "permanent": true },
    { "source": "/compare", "destination": "/", "permanent": true },
    { "source": "/case-saldev", "destination": "/", "permanent": true },
    { "source": "/roi-calculator", "destination": "/contact", "permanent": true },
    { "source": "/personal", "destination": "/", "permanent": true },
    { "source": "/quiz", "destination": "/", "permanent": true },
    { "source": "/result", "destination": "/", "permanent": true },
    { "source": "/automation", "destination": "/freight-guard", "permanent": true },
    { "source": "/unemployment-claims", "destination": "/", "permanent": true },
    { "source": "/blog/unemployment-claim-tax-rate", "destination": "/blog", "permanent": true },
    { "source": "/blog/quit-fired-laid-off", "destination": "/blog", "permanent": true },
    { "source": "/blog/respond-unemployment-claim-notice", "destination": "/blog", "permanent": true },
    { "source": "/blog/unemployment-hearing-prep", "destination": "/blog", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/assets/video/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}